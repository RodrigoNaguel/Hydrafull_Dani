{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
    
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run App",
            "stopAtLaunch": false,
            "settingsJson": "${workspaceFolder}/bin/HydraFuel-settings.json",
            "device": "${command:GetTargetDevice}"
        },
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run Tests",
            "presentation": { "hidden": true },
            "runTests": true,
            "device": "${command:GetTargetDevice}"
        },
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run Complication Apps",
            "presentation": { "hidden": true },
            "stopAtLaunch": false,
            "complicationSubscriberFolder": "${command:GetComplicationSubscriberFolder}",
            "complicationPublisherFolder": "${command:GetComplicationPublisherFolder}",
            "device": "${command:GetTargetDevice}"
        },
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run Native Pairing",
            "presentation": { "hidden": true },
            "runNativePairing": true,
            "stopAtLaunch": false,
            "device": "${command:GetTargetDevice}"
        }
    ]
}
