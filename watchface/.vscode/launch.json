{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run HydraFuel Face",
            "stopAtLaunch": false,
            "settingsJson": "${workspaceFolder}/bin/HydraFuelFace-settings.json",
            "device": "${command:GetTargetDevice}"
        },
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run Face Tests",
            "runTests": true,
            "device": "${command:GetTargetDevice}"
        },
        {
            "type": "monkeyc",
            "request": "launch",
            "name": "Run With HydraFuel",
            "stopAtLaunch": false,
            "settingsJson": "${workspaceFolder}/bin/HydraFuelFace-settings.json",
            "complicationSubscriberFolder": "${workspaceFolder}",
            "complicationPublisherFolder": "${workspaceFolder}/..",
            "device": "${command:GetTargetDevice}"
        }
    ]
}
